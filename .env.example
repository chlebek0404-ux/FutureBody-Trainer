# Supabase — uzupełnimy podczas etapu integracji backendu
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — uzupełnimy podczas etapu obsługi plików
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Tryb podglądu do recenzji interfejsu bez backendu.
# Działa tylko przy braku Supabase. NIE ustawiaj tego na produkcji.
NEXT_PUBLIC_PREVIEW_MODE=

# Publiczny adres aplikacji — uzupełnimy przy wdrożeniu
NEXT_PUBLIC_APP_URL=http://localhost:3000
